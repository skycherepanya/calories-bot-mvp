.env
node_modules

# ── macOS system files ──────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Lifecore: Raw Data (large files, not for git) ───────────
# Apple Health XML export (1.97 GB — too large for git)
Lifecore/data/health/
# Strava binary activity files (.fit.gz, .gpx.gz, media)
Lifecore/data/strava/activities/
Lifecore/data/strava/media/
Lifecore/data/export.zip
Lifecore/data/*.zip

# ── Lifecore: Generated reports (regenerated by scripts) ────
# daily_health_summary.json is generated by deep_health_analysis.py
# Uncomment if you do NOT want to track it:
# Lifecore/reports/daily_health_summary.json

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# ── Supabase ────────────────────────────────────────────────
.supabase/